{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*\\.performance-spec\\.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": { "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.spec.json", "useESM": true }] },
  "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" },
  "testEnvironment": "node"
}
