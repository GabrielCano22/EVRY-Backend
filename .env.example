DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evry?schema=public"
# Use two distinct, randomly generated secrets of at least 32 characters.
JWT_ACCESS_SECRET="replace-with-a-unique-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-unique-random-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
MEDIA_BASE_URL="http://localhost:4000"
NODE_ENV=development
SWAGGER_ENABLED=false
