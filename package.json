{
  "name": "evry-backend",
  "version": "0.1.0",
  "description": "EVRY backend - fitness app with hormonal cycle integration",
  "private": true,
  "engines": {
    "node": "24.14.x",
    "npm": "11.x"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:validate": "cross-env DATABASE_URL=postgresql://evry:evry@127.0.0.1:5432/evry prisma validate",
    "prisma:generate": "cross-env DATABASE_URL=postgresql://evry:evry@127.0.0.1:5432/evry prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "openapi:generate": "npm run build && cross-env DATABASE_URL=postgresql://evry:evry@127.0.0.1:5432/evry JWT_ACCESS_SECRET=access-secret-123456789012345678901 JWT_REFRESH_SECRET=refresh-secret-12345678901234567890 CORS_ORIGIN=http://localhost:3000 PORT=4000 SWAGGER_ENABLED=false node scripts/generate-openapi.cjs",
    "openapi:check": "npm run openapi:generate && git diff --exit-code -- openapi/evry-v1.json openapi/client.generated.ts",
    "seed": "ts-node prisma/seed.ts",
    "exercises:verify": "ts-node scripts/verify-exercise-assets.ts",
    "exercises:import": "ts-node prisma/import-exercises.ts",
    "exercises:check-import": "ts-node scripts/verify-exercise-import.ts",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" --max-warnings 0",
    "test": "cross-env TZ=America/Bogota NODE_OPTIONS=--experimental-vm-modules jest",
    "lint:check": "eslint \"{src,test,scripts}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "test:unit": "cross-env TZ=America/Bogota NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:integration": "cross-env TZ=America/Bogota NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-integration.json --runInBand",
    "test:type-check": "tsc --noEmit -p tsconfig.spec.json",
    "test:db:migrate": "ts-node scripts/migrate-test-database.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.4.2",
    "helmet": "^7.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "^20.11.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.1",
    "jest": "30.5.0",
    "openapi-typescript": "7.10.1",
    "prisma": "^7.10.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "8.57.0"
  }
}
